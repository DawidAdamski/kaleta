FROM python:3.13-slim

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy dependency files first for layer caching
COPY pyproject.toml uv.lock* README.md ./

# Full image — Prophet forecasting and the hosted extras (Redis, the Supabase
# Auth client); excludes the dev group. The PostgreSQL drivers are base deps.
RUN uv sync --frozen --no-dev --extra forecast --extra hosted --no-install-project

# Copy application code
COPY src/ src/
COPY alembic/ alembic/
COPY alembic.ini ./
# The tenant registry's migrations (every instance keeps a `public` registry).
COPY alembic_public/ alembic_public/
COPY alembic_public.ini ./

# The project itself, now that its code is in place.
RUN uv sync --frozen --no-dev --extra forecast --extra hosted

# `uv run` would otherwise sync the dev group into the image at every start.
ENV UV_NO_SYNC=1

EXPOSE 8080

CMD ["uv", "run", "kaleta"]
