FROM python:3.13-slim

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy dependency files first for layer caching
COPY pyproject.toml uv.lock* README.md ./

# Full image — Prophet forecasting and the hosted layout's drivers (Redis,
# PostgreSQL); excludes the dev group. One image, two layouts: env decides.
RUN uv sync --frozen --no-dev --extra forecast --extra hosted

# Copy application code
COPY src/ src/
COPY alembic/ alembic/
COPY alembic.ini* ./
# The tenant registry's migrations (KALETA_TENANCY=multi).
COPY alembic_public/ alembic_public/
COPY alembic_public.ini ./

EXPOSE 8080

CMD ["uv", "run", "kaleta"]
